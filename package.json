{
  "name": "saas-pricing-mcp",
  "version": "0.3.0",
  "description": "Remote MCP server: current SaaS pricing (USD and GBP) for AI agents",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "validate": "node scripts/validate.mjs",
    "typecheck": "tsc -p .",
    "test": "node test/history.test.mjs && node test/smoke.mjs",
    "record-history": "node scripts/record-history.mjs",
    "monthly-report": "node scripts/monthly-report.mjs",
    "check-pages": "node scripts/check-pages.mjs",
    "db:init": "wrangler d1 execute saas-pricing-mcp --remote --file=schema.sql"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  },
  "type": "module",
  "private": true
}
